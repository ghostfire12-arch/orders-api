# Copy these settings into your environment. NEVER put real secrets in this
# file: it is committed to git. A real ".env" file is git-ignored.

# Signs login tokens. Generate one with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-long-random-value

# Minutes a login token stays valid.
ACCESS_TOKEN_MINUTES=30

# Payments. "fake" charges nothing (development). "paystack" is real.
PAYMENT_PROVIDER=fake
# Only for the fake provider: signs its test webhooks.
PAYMENT_WEBHOOK_SECRET=replace-me-with-another-long-random-value
# Only for PAYMENT_PROVIDER=paystack. Use your TEST key first (sk_test_...).
# Never commit a real key. Set it in your environment, not in this file.
# PAYSTACK_SECRET_KEY=
# Currency for all orders (smallest unit is used, e.g. kobo for NGN).
CURRENCY=NGN

# Where the database lives. Defaults to a local SQLite file.
# DATABASE_URL=sqlite:///./orders.db
