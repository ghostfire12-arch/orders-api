# Copy these settings into your environment. NEVER put real secrets in this
# file: it is committed to git. A real ".env" file is git-ignored.

# Signs login tokens. Generate one with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-long-random-value

# Minutes a login token stays valid.
ACCESS_TOKEN_MINUTES=30

# Where the database lives. Defaults to a local SQLite file.
# DATABASE_URL=sqlite:///./orders.db
